# Copy to .env and fill in real values. .env itself must never be committed.

DATABASE_URL=postgresql+psycopg2://recovery_user:recovery_password@localhost:5432/revenue_recovery
# For quick local runs without Docker, sqlite works too:
# DATABASE_URL=sqlite:///./revenue_recovery.db

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=5.0

ECONOMIC_FLOOR=100.0

# Unused until RealPaymentSystemClient replaces MockPaymentSystemClient.
JAVA_PAYMENT_API_BASE_URL=http://localhost:8081
JAVA_PAYMENT_API_KEY=
JAVA_PAYMENT_API_SECRET=
